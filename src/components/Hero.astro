---
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<header class="hero">
  <div class="container grid items-center gap-14 grid-cols-[1.15fr_0.85fr] max-[960px]:grid-cols-1 max-[960px]:gap-10">
    <div>
      <div class="mb-[22px] inline-flex items-center gap-2 rounded-full border border-green-500/40 bg-green-500/14 px-3.5 py-1.5 text-[13px] font-semibold text-green-200">
        <span class="h-2 w-2 rounded-full bg-green-400"></span> {t('hero.badge')}
      </div>
      <h1 class="text-[52px] font-extrabold leading-[1.15] tracking-[-0.02em] text-white max-[960px]:text-[40px] max-[640px]:text-[33px]">
        {t('hero.title1')}<br /><span class="grad">{t('hero.title2')}</span>
      </h1>
      <p class="mt-5 max-w-[560px] text-[18px] text-dark-muted">{t('hero.lead')}</p>
      <div class="mt-[34px] flex flex-wrap gap-3.5">
        <a class="btn btn-primary" href={localizePath('/#demo', lang)}>{t('hero.cta.primary')}</a>
        <a class="btn btn-ghost" href={localizePath('/#solution', lang)}>{t('hero.cta.secondary')}</a>
      </div>
      <div class="mt-[30px] flex flex-wrap gap-7">
        <div class="text-[14px] text-dark-faint"><b class="block text-[20px] text-dark-text">{t('hero.meta.evidence.title')}</b>{t('hero.meta.evidence.desc')}</div>
        <div class="text-[14px] text-dark-faint"><b class="block text-[20px] text-dark-text">{t('hero.meta.loop.title')}</b>{t('hero.meta.loop.desc')}</div>
        <div class="text-[14px] text-dark-faint"><b class="block text-[20px] text-dark-text">{t('hero.meta.trust.title')}</b>{t('hero.meta.trust.desc')}</div>
      </div>
    </div>
    <div class="rounded-2xl border border-dark-border bg-dark-card p-[22px] shadow-[0_24px_60px_rgba(0,0,0,0.45)]">
      <div class="mb-4 flex items-center gap-3">
        <div class="grid h-11 w-11 place-items-center rounded-full bg-gradient-to-br from-green-400 to-teal-400 font-extrabold text-dark-bg">L</div>
        <div>
          <div class="text-[15px] font-bold text-dark-text">{t('hero.repo.name')}</div>
          <div class="text-[13px] text-dark-faint">{t('hero.repo.handle')}</div>
        </div>
        <div class="ml-auto rounded-full border border-green-400/45 bg-green-500/15 px-2.5 py-1 text-[12px] font-bold text-green-200">{t('hero.repo.verified')}</div>
      </div>
      <div class="mb-3 rounded-[10px] bg-dark-border px-3.5 py-3">
        <div class="mb-2 text-[14px] font-semibold text-sky-300">{t('hero.repo.repoTitle')}</div>
        <div class="mb-2.5 text-[12px] text-dark-muted">{t('hero.repo.repoDesc')}</div>
        <div class="text-[12px] text-dark-muted">{t('hero.repo.langLabel')}</div>
        <div class="bar ts"><i></i></div>
        <div class="bar pg"><i></i></div>
        <div class="bar ht"><i></i></div>
      </div>
      <div class="flex flex-wrap gap-2">
        <span class="rounded-full border border-slate-700 bg-dark-card px-2.5 py-[3px] text-[11px] text-dark-muted">{t('hero.repo.tag1')}</span>
        <span class="rounded-full border border-slate-700 bg-dark-card px-2.5 py-[3px] text-[11px] text-dark-muted">{t('hero.repo.tag2')}</span>
        <span class="rounded-full border border-slate-700 bg-dark-card px-2.5 py-[3px] text-[11px] text-dark-muted">{t('hero.repo.tag3')}</span>
        <span class="rounded-full border border-slate-700 bg-dark-card px-2.5 py-[3px] text-[11px] text-dark-muted">{t('hero.repo.tag4')}</span>
      </div>
      <div class="mt-3.5 flex gap-[18px] text-[13px] text-dark-muted">
        <span>{t('hero.repo.stat1')} <b class="text-dark-text">486</b></span>
        <span>{t('hero.repo.stat2')} <b class="text-dark-text">127</b></span>
        <span>{t('hero.repo.stat3')} <b class="text-dark-text">{t('hero.repo.stat3val')}</b></span>
      </div>
      <div class="mt-3 text-right text-[11px] text-slate-500">{t('hero.repo.note')}</div>
    </div>
  </div>
</header>
