---
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<header class="hero">
  <div class="container hero-grid">
    <div>
      <div class="hero-badge"><span class="dot"></span> {t('hero.badge')}</div>
      <h1>{t('hero.title1')}<br /><span class="grad">{t('hero.title2')}</span></h1>
      <p class="lead">{t('hero.lead')}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={localizePath('/#demo', lang)}>{t('hero.cta.primary')}</a>
        <a class="btn btn-ghost" href={localizePath('/#solution', lang)}>{t('hero.cta.secondary')}</a>
      </div>
      <div class="hero-meta">
        <div class="m"><b>{t('hero.meta.evidence.title')}</b>{t('hero.meta.evidence.desc')}</div>
        <div class="m"><b>{t('hero.meta.loop.title')}</b>{t('hero.meta.loop.desc')}</div>
        <div class="m"><b>{t('hero.meta.trust.title')}</b>{t('hero.meta.trust.desc')}</div>
      </div>
    </div>
    <div class="repo-card">
      <div class="rc-head">
        <div class="rc-avatar">L</div>
        <div>
          <div class="rc-name">{t('hero.repo.name')}</div>
          <div class="rc-handle">{t('hero.repo.handle')}</div>
        </div>
        <div class="rc-badge">{t('hero.repo.verified')}</div>
      </div>
      <div class="rc-repo">
        <div class="r-title">{t('hero.repo.repoTitle')}</div>
        <div class="r-desc">{t('hero.repo.repoDesc')}</div>
        <div style="font-size:12px;color:#94a3b8;">{t('hero.repo.langLabel')}</div>
        <div class="bar ts"><i></i></div>
        <div class="bar pg"><i></i></div>
        <div class="bar ht"><i></i></div>
      </div>
      <div class="rc-tags">
        <span>{t('hero.repo.tag1')}</span><span>{t('hero.repo.tag2')}</span><span>{t('hero.repo.tag3')}</span><span>{t('hero.repo.tag4')}</span>
      </div>
      <div class="rc-stats">
        <span>{t('hero.repo.stat1')} <b>486</b></span>
        <span>{t('hero.repo.stat2')} <b>127</b></span>
        <span>{t('hero.repo.stat3')} <b>{t('hero.repo.stat3val')}</b></span>
      </div>
      <div class="rc-note">{t('hero.repo.note')}</div>
    </div>
  </div>
</header>
