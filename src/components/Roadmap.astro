---
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="roadmap" class="roadmap">
  <div class="container">
    <span class="eyebrow" style="background:rgba(22,163,74,0.16);border-color:rgba(74,222,128,0.4);color:#4ade80;">{t('roadmap.eyebrow')}</span>
    <h2>{t('roadmap.title')}</h2>
    <p class="sub">{t('roadmap.sub')}</p>
    <div class="roadmap-grid">
      <div class="rm-card">
        <span class="status">{t('roadmap.m1.status')}</span>
        <h3>{t('roadmap.m1.title')}</h3>
        <p>{t('roadmap.m1.desc')}</p>
        <ul>
          <li>{t('roadmap.m1.item1')}</li>
          <li>{t('roadmap.m1.item2')}</li>
          <li>{t('roadmap.m1.item3')}</li>
        </ul>
      </div>
      <div class="rm-card">
        <span class="status">{t('roadmap.m2.status')}</span>
        <h3>{t('roadmap.m2.title')}</h3>
        <p>{t('roadmap.m2.desc')}</p>
        <ul>
          <li>{t('roadmap.m2.item1')}</li>
          <li>{t('roadmap.m2.item2')}</li>
          <li>{t('roadmap.m2.item3')}</li>
        </ul>
      </div>
      <div class="rm-card">
        <span class="status">{t('roadmap.m3.status')}</span>
        <h3>{t('roadmap.m3.title')}</h3>
        <p>{t('roadmap.m3.desc')}</p>
        <ul>
          <li>{t('roadmap.m3.item1')}</li>
          <li>{t('roadmap.m3.item2')}</li>
          <li>{t('roadmap.m3.item3')}</li>
        </ul>
      </div>
      <div class="rm-card">
        <span class="status">{t('roadmap.m4.status')}</span>
        <h3>{t('roadmap.m4.title')}</h3>
        <p>{t('roadmap.m4.desc')}</p>
        <ul>
          <li>{t('roadmap.m4.item1')}</li>
          <li>{t('roadmap.m4.item2')}</li>
          <li>{t('roadmap.m4.item3')}</li>
        </ul>
      </div>
    </div>
  </div>
</section>
