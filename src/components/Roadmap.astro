---
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="roadmap" class="bg-dark-bg text-dark-text">
  <div class="container">
    <span class="eyebrow !border-green-400/40 !bg-green-500/15 !text-green-400">{t('roadmap.eyebrow')}</span>
    <h2 class="text-white">{t('roadmap.title')}</h2>
    <p class="sub text-dark-muted">{t('roadmap.sub')}</p>
    <div class="mt-11 grid grid-cols-4 gap-[18px] max-[960px]:grid-cols-2 max-[640px]:grid-cols-1">
      <div class="rounded-card border border-dark-border bg-dark-card p-6">
        <span class="mb-3.5 inline-block rounded-full border border-green-400/40 bg-green-500/15 px-2.5 py-1 text-[12px] font-bold text-green-200">{t('roadmap.m1.status')}</span>
        <h3 class="mb-2.5 text-[17px] font-bold text-white">{t('roadmap.m1.title')}</h3>
        <p class="text-[14px] text-dark-muted">{t('roadmap.m1.desc')}</p>
        <ul class="mt-3 list-none text-[13px] text-slate-300">
          <li class="relative py-1 pl-[18px] before:absolute before:left-0 before:text-green-400 before:content-['→']">{t('roadmap.m1.item1')}</li>
          <li class="relative py-1 pl-[18px] before:absolute before:left-0 before:text-green-400 before:content-['→']">{t('roadmap.m1.item2')}</li>
          <li class="relative py-1 pl-[18px] before:absolute before:left-0 before:text-green-400 before:content-['→']">{t('roadmap.m1.item3')}</li>
        </ul>
      </div>
      <div class="rounded-card border border-dark-border bg-dark-card p-6">
        <span class="mb-3.5 inline-block rounded-full border border-green-400/40 bg-green-500/15 px-2.5 py-1 text-[12px] font-bold text-green-200">{t('roadmap.m2.status')}</span>
        <h3 class="mb-2.5 text-[17px] font-bold text-white">{t('roadmap.m2.title')}</h3>
        <p class="text-[14px] text-dark-muted">{t('roadmap.m2.desc')}</p>
        <ul class="mt-3 list-none text-[13px] text-slate-300">
          <li class="relative py-1 pl-[18px] before:absolute before:left-0 before:text-green-400 before:content-['→']">{t('roadmap.m2.item1')}</li>
          <li class="relative py-1 pl-[18px] before:absolute before:left-0 before:text-green-400 before:content-['→']">{t('roadmap.m2.item2')}</li>
          <li class="relative py-1 pl-[18px] before:absolute before:left-0 before:text-green-400 before:content-['→']">{t('roadmap.m2.item3')}</li>
        </ul>
      </div>
      <div class="rounded-card border border-dark-border bg-dark-card p-6">
        <span class="mb-3.5 inline-block rounded-full border border-green-400/40 bg-green-500/15 px-2.5 py-1 text-[12px] font-bold text-green-200">{t('roadmap.m3.status')}</span>
        <h3 class="mb-2.5 text-[17px] font-bold text-white">{t('roadmap.m3.title')}</h3>
        <p class="text-[14px] text-dark-muted">{t('roadmap.m3.desc')}</p>
        <ul class="mt-3 list-none text-[13px] text-slate-300">
          <li class="relative py-1 pl-[18px] before:absolute before:left-0 before:text-green-400 before:content-['→']">{t('roadmap.m3.item1')}</li>
          <li class="relative py-1 pl-[18px] before:absolute before:left-0 before:text-green-400 before:content-['→']">{t('roadmap.m3.item2')}</li>
          <li class="relative py-1 pl-[18px] before:absolute before:left-0 before:text-green-400 before:content-['→']">{t('roadmap.m3.item3')}</li>
        </ul>
      </div>
      <div class="rounded-card border border-dark-border bg-dark-card p-6">
        <span class="mb-3.5 inline-block rounded-full border border-green-400/40 bg-green-500/15 px-2.5 py-1 text-[12px] font-bold text-green-200">{t('roadmap.m4.status')}</span>
        <h3 class="mb-2.5 text-[17px] font-bold text-white">{t('roadmap.m4.title')}</h3>
        <p class="text-[14px] text-dark-muted">{t('roadmap.m4.desc')}</p>
        <ul class="mt-3 list-none text-[13px] text-slate-300">
          <li class="relative py-1 pl-[18px] before:absolute before:left-0 before:text-green-400 before:content-['→']">{t('roadmap.m4.item1')}</li>
          <li class="relative py-1 pl-[18px] before:absolute before:left-0 before:text-green-400 before:content-['→']">{t('roadmap.m4.item2')}</li>
          <li class="relative py-1 pl-[18px] before:absolute before:left-0 before:text-green-400 before:content-['→']">{t('roadmap.m4.item3')}</li>
        </ul>
      </div>
    </div>
  </div>
</section>
