---
import BayjfLink from '@bay/landing-ui/components/BayjfLink.astro';
import StarOnGithub from '@bay/landing-ui/components/StarOnGithub.astro';
import { getLangFromUrl, useTranslations, localizePath, getAltLangPath } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const altPath = getAltLangPath(Astro.url, lang);
---
<nav class="nav" id="top">
  <div class="container nav-inner">
    <a class="logo" href={localizePath('/', lang)}>
      <span class="logo-mark">J</span>
      JobAgent
    </a>
    <ul class="nav-links">
      <li><a href={localizePath('/#problem', lang)}>{t('nav.problem')}</a></li>
      <li><a href={localizePath('/#solution', lang)}>{t('nav.solution')}</a></li>
      <li><a href={localizePath('/#moat', lang)}>{t('nav.moat')}</a></li>
      <li><a href={localizePath('/#roadmap', lang)}>{t('nav.roadmap')}</a></li>
    </ul>
    <div class="nav-ext">
      <BayjfLink size={18} class="nav-bayjf" />
      <StarOnGithub href="https://github.com/bayernjf/job-agent" size={15} class="nav-star" />
      <a href={altPath} class="nav-lang" hreflang={lang === 'zh' ? 'en' : 'zh-CN'}>{t('nav.langSwitch')}</a>
    </div>
    <a class="nav-cta" href={localizePath('/#demo', lang)}>{t('nav.cta')}</a>
  </div>
</nav>
