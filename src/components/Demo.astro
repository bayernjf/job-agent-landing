---
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="demo">
  <div class="container">
    <div class="mx-auto max-w-[620px] rounded-[18px] border border-border bg-surface px-9 py-11 text-center shadow-card">
      <span class="eyebrow">{t('demo.eyebrow')}</span>
      <h2 class="text-[28px]">{t('demo.title')}</h2>
      <p class="sub mx-auto mt-2.5 text-[15px]">{t('demo.sub')}</p>
      <form class="mt-[26px] flex gap-2.5 max-[640px]:flex-col" id="demo-form">
        <input
          type="text"
          id="gh-input"
          placeholder={t('demo.placeholder')}
          autocomplete="off"
          spellcheck="false"
          aria-label="GitHub username"
          class="flex-1 rounded-[10px] border border-border px-[18px] py-[13px] font-sans text-[15px] outline-none transition-colors focus:border-brand"
        />
        <button type="submit" class="cursor-pointer rounded-[10px] bg-brand px-[22px] py-[13px] font-sans text-[15px] font-bold text-white transition-colors hover:bg-brand-dark">{t('demo.button')}</button>
      </form>
      <div class="mt-3.5 text-[13px] text-ink-3" id="demo-tip">{t('demo.tip')}</div>
      <div class="mt-[18px] hidden rounded-[10px] border border-green-200 bg-brand-soft px-4 py-3 text-[14px] text-green-900" id="demo-result"></div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('demo-form');
  const input = document.getElementById('gh-input');
  const result = document.getElementById('demo-result');
  const tip = document.getElementById('demo-tip');

  // Detect language from URL path (English at root, Chinese at /zh/)
  const path = window.location.pathname;
  const isEn = !path.startsWith('/zh');
  const messages = isEn ? {
    empty: 'Please enter a GitHub username',
    success: (name: string, count: number) => `Recorded @${name}, you've joined the beta queue (position #${count}).`,
    error: 'Browser doesn\'t support local storage. Please try a different browser.',
  } : {
    empty: '请输入 GitHub 用户名',
    success: (name: string, count: number) => `已记录 @${name}，你已加入内测队列（第 ${count} 位）。`,
    error: '浏览器不支持本地存储，请换个浏览器试试。',
  };

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = input?.value.trim();
    if (!name) {
      if (result) {
        result.style.display = 'block';
        result.style.color = '#92400e';
        result.style.background = '#fffbeb';
        result.style.borderColor = '#fcd34d';
        result.textContent = messages.empty;
      }
      return;
    }
    try {
      const key = 'jobagent_waitlist';
      const list = JSON.parse(localStorage.getItem(key) || '[]');
      if (!list.includes(name)) list.push(name);
      localStorage.setItem(key, JSON.stringify(list));
      if (tip) tip.style.display = 'none';
      if (result) {
        result.style.display = 'block';
        result.style.color = '#14532d';
        result.style.background = '#f0fdf4';
        result.style.borderColor = '#bbf7d0';
        result.textContent = messages.success(name, list.length);
      }
      if (input) input.value = '';
    } catch {
      if (result) {
        result.style.display = 'block';
        result.style.color = '#92400e';
        result.style.background = '#fffbeb';
        result.style.borderColor = '#fcd34d';
        result.textContent = messages.error;
      }
    }
  });
</script>
