---
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="demo">
  <div class="container">
    <div class="demo-box">
      <span class="eyebrow">{t('demo.eyebrow')}</span>
      <h2 style="font-size:28px;">{t('demo.title')}</h2>
      <p class="sub" style="margin:10px auto 0;font-size:15px;">{t('demo.sub')}</p>
      <form class="demo-form" id="demo-form">
        <input
          type="text"
          id="gh-input"
          placeholder={t('demo.placeholder')}
          autocomplete="off"
          spellcheck="false"
          aria-label="GitHub username"
        />
        <button type="submit">{t('demo.button')}</button>
      </form>
      <div class="demo-tip" id="demo-tip">{t('demo.tip')}</div>
      <div class="demo-result" id="demo-result"></div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('demo-form');
  const input = document.getElementById('gh-input');
  const result = document.getElementById('demo-result');
  const tip = document.getElementById('demo-tip');

  // Detect language from URL path (English at root, Chinese at /zh/)
  const path = window.location.pathname;
  const isEn = !path.startsWith('/zh');
  const messages = isEn ? {
    empty: 'Please enter a GitHub username',
    success: (name: string, count: number) => `Recorded @${name}, you've joined the beta queue (position #${count}).`,
    error: 'Browser doesn\'t support local storage. Please try a different browser.',
  } : {
    empty: '请输入 GitHub 用户名',
    success: (name: string, count: number) => `已记录 @${name}，你已加入内测队列（第 ${count} 位）。`,
    error: '浏览器不支持本地存储，请换个浏览器试试。',
  };

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = input?.value.trim();
    if (!name) {
      if (result) {
        result.style.display = 'block';
        result.style.color = '#92400e';
        result.style.background = '#fffbeb';
        result.style.borderColor = '#fcd34d';
        result.textContent = messages.empty;
      }
      return;
    }
    try {
      const key = 'jobagent_waitlist';
      const list = JSON.parse(localStorage.getItem(key) || '[]');
      if (!list.includes(name)) list.push(name);
      localStorage.setItem(key, JSON.stringify(list));
      if (tip) tip.style.display = 'none';
      if (result) {
        result.style.display = 'block';
        result.style.color = '#14532d';
        result.style.background = '#f0fdf4';
        result.style.borderColor = '#bbf7d0';
        result.textContent = messages.success(name, list.length);
      }
      if (input) input.value = '';
    } catch {
      if (result) {
        result.style.display = 'block';
        result.style.color = '#92400e';
        result.style.background = '#fffbeb';
        result.style.borderColor = '#fcd34d';
        result.textContent = messages.error;
      }
    }
  });
</script>
