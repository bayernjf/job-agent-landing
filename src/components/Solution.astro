---
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="solution" class="border-y border-border bg-surface">
  <div class="container">
    <span class="eyebrow">{t('solution.eyebrow')}</span>
    <h2>{t('solution.title')}</h2>
    <p class="sub">{t('solution.sub')}</p>
    <p class="mvp-note">{t('solution.mvpNote')}</p>

    <div class="mt-11">
      <div class="rounded-card border border-blue-200 bg-blue-50 p-6">
        <h3 class="mb-3.5 flex items-center gap-2 text-[16px] font-bold text-blue-900">
          <span class="rounded-md bg-blue-100 px-2 py-[3px] text-[11px] font-bold text-blue-900">{t('solution.b.tag')}</span>
          {t('solution.b.title')}
        </h3>
        <div class="grid grid-cols-3 gap-3 max-[640px]:grid-cols-1">
          <div class="rounded-[10px] border border-border bg-white p-3.5 text-[13px] text-ink-2">
            <span class="mb-1 block text-[12px] font-extrabold text-brand-dark">①</span>
            <span class="mb-1 block text-[14px] font-bold text-ink">{t('solution.b.step1.title')}</span>
            {t('solution.b.step1.desc')}
          </div>
          <div class="rounded-[10px] border border-border bg-white p-3.5 text-[13px] text-ink-2">
            <span class="mb-1 block text-[12px] font-extrabold text-brand-dark">②</span>
            <span class="mb-1 block text-[14px] font-bold text-ink">{t('solution.b.step2.title')}</span>
            {t('solution.b.step2.desc')}
          </div>
          <div class="rounded-[10px] border border-border bg-white p-3.5 text-[13px] text-ink-2">
            <span class="mb-1 block text-[12px] font-extrabold text-brand-dark">③</span>
            <span class="mb-1 block text-[14px] font-bold text-ink">{t('solution.b.step3.title')}</span>
            {t('solution.b.step3.desc')}
          </div>
        </div>
      </div>

      <div class="my-[22px] flex flex-wrap items-center justify-center gap-3.5 rounded-xl border border-dashed border-green-300 bg-gradient-to-r from-green-500/[0.08] to-teal-600/10 px-[22px] py-4 text-center text-[15px] font-bold text-green-900">
        <div class="text-center">
          🟢 {t('solution.bridge.title')}
          <small class="block text-[13px] font-medium text-green-800">{t('solution.bridge.sub')}</small>
        </div>
      </div>

      <div class="rounded-card border border-red-200 bg-red-50 p-6">
        <h3 class="mb-3.5 flex items-center gap-2 text-[16px] font-bold text-red-900">
          <span class="rounded-md bg-red-100 px-2 py-[3px] text-[11px] font-bold text-red-900">{t('solution.c.tag')}</span>
          {t('solution.c.title')}
        </h3>
        <div class="grid grid-cols-3 gap-3 max-[640px]:grid-cols-1">
          <div class="rounded-[10px] border border-border bg-white p-3.5 text-[13px] text-ink-2">
            <span class="mb-1 block text-[12px] font-extrabold text-brand-dark">①</span>
            <span class="mb-1 block text-[14px] font-bold text-ink">{t('solution.c.step1.title')}</span>
            {t('solution.c.step1.desc')}
          </div>
          <div class="rounded-[10px] border border-border bg-white p-3.5 text-[13px] text-ink-2">
            <span class="mb-1 block text-[12px] font-extrabold text-brand-dark">②</span>
            <span class="mb-1 block text-[14px] font-bold text-ink">{t('solution.c.step2.title')}</span>
            {t('solution.c.step2.desc')}
          </div>
          <div class="rounded-[10px] border border-border bg-white p-3.5 text-[13px] text-ink-2">
            <span class="mb-1 block text-[12px] font-extrabold text-brand-dark">③</span>
            <span class="mb-1 block text-[14px] font-bold text-ink">{t('solution.c.step3.title')}</span>
            {t('solution.c.step3.desc')}
          </div>
        </div>
      </div>

      <div class="mt-[22px] rounded-xl border border-dashed border-amber-300 bg-amber-soft px-5 py-3.5 text-center text-[14px] text-amber-900">
        <b class="text-amber-800">{lang === 'zh' ? '反馈闭环：' : 'Feedback loop:'}</b>{t('solution.feedback')}
      </div>
    </div>
  </div>
</section>
