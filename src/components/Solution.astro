---
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="solution" class="solution">
  <div class="container">
    <span class="eyebrow">{t('solution.eyebrow')}</span>
    <h2>{t('solution.title')}</h2>
    <p class="sub">{t('solution.sub')}</p>
    <p class="mvp-note">{t('solution.mvpNote')}</p>

    <div style="margin-top:44px;">
      <div class="lane lane-b">
        <h3><span class="lane-tag">{t('solution.b.tag')}</span>{t('solution.b.title')}</h3>
        <div class="lane-steps">
          <div class="step"><span class="n">①</span><span class="t">{t('solution.b.step1.title')}</span>{t('solution.b.step1.desc')}</div>
          <div class="step"><span class="n">②</span><span class="t">{t('solution.b.step2.title')}</span>{t('solution.b.step2.desc')}</div>
          <div class="step"><span class="n">③</span><span class="t">{t('solution.b.step3.title')}</span>{t('solution.b.step3.desc')}</div>
        </div>
      </div>

      <div class="bridge">
        <div style="text-align:center;">
          🟢 {t('solution.bridge.title')}
          <small>{t('solution.bridge.sub')}</small>
        </div>
      </div>

      <div class="lane lane-c">
        <h3><span class="lane-tag">{t('solution.c.tag')}</span>{t('solution.c.title')}</h3>
        <div class="lane-steps">
          <div class="step"><span class="n">①</span><span class="t">{t('solution.c.step1.title')}</span>{t('solution.c.step1.desc')}</div>
          <div class="step"><span class="n">②</span><span class="t">{t('solution.c.step2.title')}</span>{t('solution.c.step2.desc')}</div>
          <div class="step"><span class="n">③</span><span class="t">{t('solution.c.step3.title')}</span>{t('solution.c.step3.desc')}</div>
        </div>
      </div>

      <div class="feedback">
        <b>{lang === 'zh' ? '反馈闭环：' : 'Feedback loop:'}</b>{t('solution.feedback')}
      </div>
    </div>
  </div>
</section>
