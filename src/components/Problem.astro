---
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="problem">
  <div class="container">
    <span class="eyebrow">{t('problem.eyebrow')}</span>
    <h2>{t('problem.title')}</h2>
    <p class="sub">{t('problem.sub')}</p>
    <div class="mt-11 grid grid-cols-4 gap-[18px] max-[960px]:grid-cols-2 max-[640px]:grid-cols-1">
      <div class="rounded-card border border-border bg-surface p-6">
        <div class="mb-4 grid h-[42px] w-[42px] place-items-center rounded-[10px] bg-danger-soft text-[20px]">📄</div>
        <h3 class="mb-2 text-[17px] font-bold">{t('problem.card1.title')}</h3>
        <p class="text-[14px] text-ink-2">{t('problem.card1.desc')}</p>
      </div>
      <div class="rounded-card border border-border bg-surface p-6">
        <div class="mb-4 grid h-[42px] w-[42px] place-items-center rounded-[10px] bg-amber-soft text-[20px]">🎤</div>
        <h3 class="mb-2 text-[17px] font-bold">{t('problem.card2.title')}</h3>
        <p class="text-[14px] text-ink-2">{t('problem.card2.desc')}</p>
      </div>
      <div class="rounded-card border border-border bg-surface p-6">
        <div class="mb-4 grid h-[42px] w-[42px] place-items-center rounded-[10px] bg-blue-50 text-[20px]">🤖</div>
        <h3 class="mb-2 text-[17px] font-bold">{t('problem.card3.title')}</h3>
        <p class="text-[14px] text-ink-2">{t('problem.card3.desc')}</p>
      </div>
      <div class="rounded-card border border-border bg-surface p-6">
        <div class="mb-4 grid h-[42px] w-[42px] place-items-center rounded-[10px] bg-slate-100 text-[20px]">🔍</div>
        <h3 class="mb-2 text-[17px] font-bold">{t('problem.card4.title')}</h3>
        <p class="text-[14px] text-ink-2">{t('problem.card4.desc')}</p>
      </div>
    </div>
    <div class="mt-9 rounded-card bg-ink px-7 py-6 text-[17px] text-dark-text">
      <b class="text-green-400">{lang === 'zh' ? '结论：' : 'Bottom line:'}</b>{t('problem.takeaway')}
    </div>
  </div>
</section>
