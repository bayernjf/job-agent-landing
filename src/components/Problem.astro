---
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="problem">
  <div class="container">
    <span class="eyebrow">{t('problem.eyebrow')}</span>
    <h2>{t('problem.title')}</h2>
    <p class="sub">{t('problem.sub')}</p>
    <div class="problem-grid">
      <div class="problem-card">
        <div class="ic ic-red">📄</div>
        <h3>{t('problem.card1.title')}</h3>
        <p>{t('problem.card1.desc')}</p>
      </div>
      <div class="problem-card">
        <div class="ic ic-amber">🎤</div>
        <h3>{t('problem.card2.title')}</h3>
        <p>{t('problem.card2.desc')}</p>
      </div>
      <div class="problem-card">
        <div class="ic ic-blue">🤖</div>
        <h3>{t('problem.card3.title')}</h3>
        <p>{t('problem.card3.desc')}</p>
      </div>
      <div class="problem-card">
        <div class="ic ic-slate">🔍</div>
        <h3>{t('problem.card4.title')}</h3>
        <p>{t('problem.card4.desc')}</p>
      </div>
    </div>
    <div class="takeaway">
      <b>{lang === 'zh' ? '结论：' : 'Bottom line:'}</b>{t('problem.takeaway')}
    </div>
  </div>
</section>
