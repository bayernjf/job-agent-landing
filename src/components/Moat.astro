---
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="moat">
  <div class="container">
    <span class="eyebrow">{t('moat.eyebrow')}</span>
    <h2>{t('moat.title')}</h2>
    <p class="sub">{t('moat.sub')}</p>
    <div class="moat-grid">
      <div class="moat-card">
        <span class="k">{t('moat.card1.k')}</span>
        <h3>{t('moat.card1.title')}</h3>
        <p>{t('moat.card1.desc')}</p>
      </div>
      <div class="moat-card">
        <span class="k">{t('moat.card2.k')}</span>
        <h3>{t('moat.card2.title')}</h3>
        <p>{t('moat.card2.desc')}</p>
      </div>
      <div class="moat-card">
        <span class="k">{t('moat.card3.k')}</span>
        <h3>{t('moat.card3.title')}</h3>
        <p>{t('moat.card3.desc')}</p>
      </div>
    </div>
    <div class="moat-note">
      <b>{lang === 'zh' ? '为什么这是护城河：' : 'Why this is the moat:'}</b>{t('moat.note')}
    </div>
  </div>
</section>
