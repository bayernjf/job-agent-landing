---
import BayjfLink from '@bay/landing-ui/components/BayjfLink.astro';
import StarOnGithub from '@bay/landing-ui/components/StarOnGithub.astro';
import Nav from '../components/Nav.astro';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const ogImage = lang === 'zh' ? 'https://job-agent.bayjf.com/preview-zh.png' : 'https://job-agent.bayjf.com/preview-en.png';
const ogUrl = lang === 'zh' ? 'https://job-agent.bayjf.com/zh' : 'https://job-agent.bayjf.com';

const {
  title = lang === 'zh'
    ? 'JobAgent · 以 GitHub 为桥梁的智能招聘平台'
    : 'JobAgent · AI-era hiring platform built on GitHub evidence',
  description = lang === 'zh'
    ? 'AI 时代，让招聘回到真实工作证据。JobAgent 把 GitHub 仓库分析成可验证的能力画像，服务企业与求职者。'
    : 'Bring hiring back to real work evidence in the AI era. JobAgent turns GitHub repos into verifiable ability profiles for enterprises and candidates.',
} = Astro.props;
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1220" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="JobAgent" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <footer>
      <div class="container foot">
        <div>{t('footer.copyright')}</div>
        <div class="foot-ext">
          <BayjfLink size={16} class="foot-bayjf" />
          <StarOnGithub href="https://github.com/bayernjf/job-agent" size={14} class="foot-star" />
        </div>
        <div class="foot-links">
          <a href={localizePath('/privacy', lang)}>{t('footer.privacy')}</a>
          <a href={localizePath('/terms', lang)}>{t('footer.terms')}</a>
          <a href={localizePath('/#top', lang)}>{t('footer.backToTop')}</a>
        </div>
      </div>
    </footer>
  </body>
</html>
