# Landing page public build-time env vars (Astro PUBLIC_* are inlined into the static bundle).
# Copy to .env and fill in when the JobAgent backend is deployed.

# Base URL of the JobAgent API (Hono), no trailing slash.
# When set, the #demo form triggers a real analysis: POST /analyze -> poll /jobs/:id.
# When empty (default), #demo falls back to the local-storage beta waitlist demo.
# Example: https://api.job-agent.example.com
PUBLIC_API_BASE=

# Base URL of the JobAgent report app (Astro SSR), no trailing slash.
# After a successful analysis the browser navigates to
# ${PUBLIC_REPORT_BASE}/{en|zh-CN}/report/{profileId}.
# Example: https://report.job-agent.example.com
PUBLIC_REPORT_BASE=
